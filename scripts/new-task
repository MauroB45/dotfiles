#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: new-task TICKET-123 [slug] [--base <branch-or-ticket>]"
  echo
  echo "Examples:"
  echo "  new-task GP-125 travel-date-ui"
  echo "  new-task GP-125 travel-date-ui --base GP-124"
  echo "  new-task GP-125 travel-date-ui --base GP-124/domain-support"
  exit 1
}

resolve_base() {
  local input="$1"

  # Exact local branch
  if git show-ref --verify --quiet "refs/heads/$input"; then
    echo "$input"
    return
  fi

  # Ticket prefix, e.g. GP-124/*
  local matches
  matches="$(
    git for-each-ref \
      --format='%(refname:short)' \
      "refs/heads/${input}/*"
  )"

  local count
  count="$(printf '%s\n' "$matches" | grep -c . || true)"

  if [[ "$count" -eq 1 ]]; then
    echo "$matches"
    return
  fi

  if [[ "$count" -gt 1 ]]; then
    echo "Multiple branches found for $input:" >&2
    printf '  %s\n' $matches >&2
    echo >&2
    echo "Pass the full branch name with --base." >&2
    return 1
  fi

  echo "Base branch not found: $input" >&2
  return 1
}

TICKET="${1:-}"

if [[ -z "$TICKET" ]]; then
  usage
fi

shift

SLUG=""
BASE_INPUT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --base)
      if [[ $# -lt 2 ]]; then
        echo "--base requires a branch name or ticket key."
        exit 1
      fi

      BASE_INPUT="$2"
      shift 2
      ;;

    --help|-h)
      usage
      ;;

    -*)
      echo "Unknown option: $1"
      usage
      ;;

    *)
      if [[ -n "$SLUG" ]]; then
        echo "Unexpected argument: $1"
        usage
      fi

      SLUG="$1"
      shift
      ;;
  esac
done

command -v jq >/dev/null || {
  echo "jq is required"
  exit 1
}

if [[ -z "${OBSIDIAN_VAULT:-}" ]]; then
  echo "OBSIDIAN_VAULT is not configured."
  echo "Set it in ~/.zshrc.local."
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"

if [[ -z "$REPO_ROOT" ]]; then
  echo "Run new-task from inside a Git repository."
  exit 1
fi

REPO_NAME="$(basename "$REPO_ROOT")"
REPO_PARENT="$(dirname "$REPO_ROOT")"

if [[ -n "$SLUG" ]]; then
  BRANCH="${TICKET}/${SLUG}"
else
  BRANCH="$TICKET"
fi

BASE_BRANCH=""

if [[ -n "$BASE_INPUT" ]]; then
  BASE_BRANCH="$(resolve_base "$BASE_INPUT")"
fi

WORKTREE_ROOT="${REPO_PARENT}/${REPO_NAME}-worktrees"
WORKTREE_DIR="${BRANCH//\//-}"
WORKTREE_PATH="${WORKTREE_ROOT}/${WORKTREE_DIR}"

NOTES_DIR="${OBSIDIAN_VAULT}/Work/repos/${REPO_NAME}/${TICKET}"

mkdir -p "$WORKTREE_ROOT"
mkdir -p "$NOTES_DIR"

echo "Repository: $REPO_NAME"
echo "Ticket:     $TICKET"
echo "Branch:     $BRANCH"

if [[ -n "$BASE_BRANCH" ]]; then
  echo "Base:       $BASE_BRANCH"
else
  echo "Base:       current HEAD"
fi

echo "Worktree:   $WORKTREE_PATH"
echo "Notes:      $NOTES_DIR"
echo

# Create or reuse worktree
if [[ -d "$WORKTREE_PATH" ]]; then
  echo "✓ Worktree already exists"

elif git show-ref --verify --quiet "refs/heads/$BRANCH"; then
  if [[ -n "$BASE_BRANCH" ]]; then
    echo "! Branch $BRANCH already exists — ignoring --base $BASE_BRANCH"
  fi

  git worktree add "$WORKTREE_PATH" "$BRANCH"

elif [[ -n "$BASE_BRANCH" ]]; then
  git worktree add -b "$BRANCH" "$WORKTREE_PATH" "$BASE_BRANCH"

else
  git worktree add -b "$BRANCH" "$WORKTREE_PATH"
fi

# Copy local configuration that a worktree does not inherit from Git
if [[ "$REPO_ROOT" != "$WORKTREE_PATH" ]]; then
  if [[ -f "${WORKTREE_PATH}/.env.local" ]]; then
    echo "✓ .env.local already exists"
  elif [[ -f "${REPO_ROOT}/.env.local" ]]; then
    cp "${REPO_ROOT}/.env.local" "${WORKTREE_PATH}/.env.local"
    echo "✓ Copied .env.local"
  elif [[ -f "${WORKTREE_PATH}/.env.local.example" ]]; then
    cp "${WORKTREE_PATH}/.env.local.example" "${WORKTREE_PATH}/.env.local"
    echo "✓ Created .env.local from .env.local.example"
  fi

  if [[ -d "${REPO_ROOT}/.claude" ]]; then
    mkdir -p "${WORKTREE_PATH}/.claude"

    # -n keeps anything the worktree already has, including tracked files
    cp -Rn "${REPO_ROOT}/.claude/." "${WORKTREE_PATH}/.claude/" || true
    echo "✓ Copied .claude"
  fi
fi

cd "$WORKTREE_PATH"

echo
echo "Ready:"
echo "$WORKTREE_PATH"
echo

# The notes symlink resolves outside the worktree, so Claude needs the real
# path as a working directory to read it or write to it in the sandbox. The
# VS Code chat has no --add-dir, so grant it through the local settings.
SETTINGS="$WORKTREE_PATH/.claude/settings.local.json"
mkdir -p "$WORKTREE_PATH/.claude"
[[ -f "$SETTINGS" ]] || echo '{}' > "$SETTINGS"

jq --arg dir "$NOTES_DIR" \
  '.permissions.additionalDirectories = ((.permissions.additionalDirectories // []) + [$dir] | unique)' \
  "$SETTINGS" > "$SETTINGS.tmp"
mv "$SETTINGS.tmp" "$SETTINGS"

code .

echo "Claude is in the VS Code chat. Type exit here when finished."
echo

"$SHELL" || true

# Removing the worktree you are standing in fails, so only offer it when
# new-task was run from another checkout.
if [[ "$REPO_ROOT" == "$WORKTREE_PATH" ]]; then
  exit 0
fi

echo
read -r -p "Remove $WORKTREE_PATH? [y/N] " REMOVE

if [[ "$REMOVE" == [yY] ]]; then
  cd "$REPO_ROOT"

  # The copied .env.local and .claude are untracked unless the repository
  # ignores them, so a plain remove can refuse. Show what is there first.
  if ! git worktree remove "$WORKTREE_PATH"; then
    echo
    git -C "$WORKTREE_PATH" status --short
    echo
    read -r -p "Force remove and discard these changes? [y/N] " FORCE

    if [[ "$FORCE" != [yY] ]]; then
      exit 0
    fi

    git worktree remove --force "$WORKTREE_PATH"
  fi

  echo "Removed $WORKTREE_PATH (branch $BRANCH kept)"
fi
