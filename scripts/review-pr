#!/usr/bin/env bash

set -euo pipefail

REPO="${1:-}"
PR="${2:-}"

if [[ -z "$REPO" || -z "$PR" ]]; then
  echo "Usage: review-pr OWNER/REPO PR_NUMBER"
  exit 1
fi

command -v gh >/dev/null || {
  echo "gh is required"
  exit 1
}

command -v jq >/dev/null || {
  echo "jq is required"
  exit 1
}

if [[ -z "${OBSIDIAN_VAULT:-}" ]]; then
  echo "OBSIDIAN_VAULT is not configured"
  exit 1
fi

REPO_NAME="${REPO##*/}"

# Where your normal work repos live.
REPO_PATH="$HOME/Code/work/$REPO_NAME"

if [[ ! -d "$REPO_PATH/.git" ]]; then
  echo "Repository not found: $REPO_PATH"
  echo "Clone it before reviewing."
  exit 1
fi

META="$(gh pr view "$PR" \
  --repo "$REPO" \
  --json number,title,body,url,author,baseRefName,headRefName,additions,deletions,changedFiles,isDraft,reviewDecision,files)"

TITLE="$(jq -r '.title' <<<"$META")"
AUTHOR="$(jq -r '.author.login' <<<"$META")"
BASE="$(jq -r '.baseRefName' <<<"$META")"
HEAD="$(jq -r '.headRefName' <<<"$META")"
URL="$(jq -r '.url' <<<"$META")"
ADDITIONS="$(jq -r '.additions' <<<"$META")"
DELETIONS="$(jq -r '.deletions' <<<"$META")"
CHANGED_FILES="$(jq -r '.changedFiles' <<<"$META")"
BODY="$(jq -r '.body // ""' <<<"$META")"

WORKTREE_ROOT="$HOME/Code/work/${REPO_NAME}-reviews"
WORKTREE="$WORKTREE_ROOT/pr-$PR"

NOTES_DIR="$OBSIDIAN_VAULT/Work/$REPO_NAME/Reviews/PR-$PR"
REVIEW_DIR="$WORKTREE/review"
REVIEW_FILE="$NOTES_DIR/review.md"

mkdir -p "$WORKTREE_ROOT"
mkdir -p "$NOTES_DIR"

cd "$REPO_PATH"

git fetch origin

if [[ ! -d "$WORKTREE" ]]; then
  git worktree add --detach "$WORKTREE" "origin/$BASE"
fi

# Fetch/checkout the current PR in the review worktree.
cd "$WORKTREE"
gh pr checkout "$PR" --repo "$REPO" --detach --force

mkdir -p "$REVIEW_DIR"

if [[ -L "$REVIEW_DIR" || -e "$REVIEW_DIR" ]]; then
  rm -rf "$REVIEW_DIR"
fi

ln -s "$NOTES_DIR" "$REVIEW_DIR"

FILES="$(
  jq -r '.files[] | "- `" + .path + "`"' <<<"$META"
)"

CREATED_DATE="$(date '+%Y-%m-%d')"
if [[ ! -f "$REVIEW_FILE" ]]; then
  cat > "$REVIEW_FILE" <<EOF
---
categories:
  - "[[Clippings]]"
author:
  - "[[Claude]]"
status: Planning
created: $CREATED_DATE
tags:
  - clippings
---

# PR #$PR — $TITLE

## Context

- **Repository:** $REPO
- **Author:** @$AUTHOR
- **Base:** \`$BASE\`
- **Head:** \`$HEAD\`
- **Changes:** $CHANGED_FILES files, +$ADDITIONS / -$DELETIONS
- **PR:** $URL

## Description

$BODY

## Changed files

$FILES

## Summary

_To be generated by Claude._

## Architecture / approach

_To be generated by Claude._

## Files worth reviewing

_To be generated by Claude._

## Things to verify

_To be generated by Claude._

## Findings

_To be generated by Claude._

## Tests

_To be generated by Claude._

## Suggested review order

_To be generated by Claude._

## My notes

EOF
fi

echo
echo "PR #$PR — $TITLE"
echo "$URL"
echo
echo "Worktree: $WORKTREE"
echo "Review:   $REVIEW_FILE"
echo

cd "$WORKTREE"

exec claude "/review-pr"