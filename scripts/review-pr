#!/usr/bin/env bash

set -euo pipefail

DONE=false

if [[ "${1:-}" == "--done" ]]; then
  DONE=true
  shift
fi

REPO="${1:-}"
PR="${2:-}"

if [[ -z "$REPO" || -z "$PR" ]]; then
  echo "Usage: review-pr [--done] OWNER/REPO PR_NUMBER"
  exit 1
fi

command -v gh >/dev/null || {
  echo "gh is required"
  exit 1
}

command -v jq >/dev/null || {
  echo "jq is required"
  exit 1
}

REPO_NAME="${REPO##*/}"

# A clone can be named differently from its GitHub repository. Map the two with
# REPO_ALIASES in ~/.zshrc.local, e.g. "geppetto-sender-ui=sender-ui".
DIR_NAME="$REPO_NAME"

for ALIAS in ${REPO_ALIASES:-}; do
  if [[ "${ALIAS%%=*}" == "$REPO_NAME" ]]; then
    DIR_NAME="${ALIAS#*=}"
    break
  fi
done

# Where your repos live. Override CODE_ROOT to review a repo cloned elsewhere.
CODE_ROOT="${CODE_ROOT:-$HOME/Code/work}"
REPO_PATH="$CODE_ROOT/$DIR_NAME"

if [[ ! -d "$REPO_PATH/.git" ]]; then
  echo "Repository not found: $REPO_PATH"
  echo "Clone it before reviewing, set CODE_ROOT to where it lives, or map it"
  echo "with REPO_ALIASES if the directory is named differently."
  exit 1
fi

WORKTREE_ROOT="${REPO_PATH}-reviews"
WORKTREE="$WORKTREE_ROOT/pr-$PR"

# The review doc is scratch for one review, so it lives in the worktree and
# goes with it. Git ignores it through the global ignore file.
REVIEW_FILE="$WORKTREE/.claude/review.md"

if [[ "$DONE" == true ]]; then
  if [[ -z "${OBSIDIAN_VAULT:-}" ]]; then
    echo "OBSIDIAN_VAULT is not configured"
    echo "Set it in ~/.zshrc.local."
    exit 1
  fi

  if [[ ! -d "$WORKTREE" ]]; then
    echo "Review worktree not found: $WORKTREE"
    exit 1
  fi

  # What outlives a review is the retro entry in the repository's review log.
  NOTES_DIR="$OBSIDIAN_VAULT/Work/$DIR_NAME/Reviews"
  mkdir -p "$NOTES_DIR"

  cd "$WORKTREE"
  claude --add-dir "$NOTES_DIR" "/review-retro $REPO $PR"

  echo
  read -r -p "Remove $WORKTREE? [y/N] " REMOVE

  if [[ "$REMOVE" == [yY] ]]; then
    cd "$REPO_PATH"
    git worktree remove "$WORKTREE"
    echo "Removed $WORKTREE"
  fi

  exit 0
fi

META="$(gh pr view "$PR" \
  --repo "$REPO" \
  --json number,title,body,url,author,baseRefName,headRefName,additions,deletions,changedFiles,isDraft,reviewDecision,files)"

TITLE="$(jq -r '.title' <<<"$META")"
AUTHOR="$(jq -r '.author.login' <<<"$META")"
BASE="$(jq -r '.baseRefName' <<<"$META")"
HEAD="$(jq -r '.headRefName' <<<"$META")"
URL="$(jq -r '.url' <<<"$META")"
ADDITIONS="$(jq -r '.additions' <<<"$META")"
DELETIONS="$(jq -r '.deletions' <<<"$META")"
CHANGED_FILES="$(jq -r '.changedFiles' <<<"$META")"
BODY="$(jq -r '.body // ""' <<<"$META")"

mkdir -p "$WORKTREE_ROOT"

cd "$REPO_PATH"

git fetch origin

if [[ ! -d "$WORKTREE" ]]; then
  git worktree add --detach "$WORKTREE" "origin/$BASE"
fi

# Fetch/checkout the current PR in the review worktree.
cd "$WORKTREE"
gh pr checkout "$PR" --repo "$REPO" --detach --force

mkdir -p "$WORKTREE/.claude"

FILES="$(
  jq -r '.files[] | "- `" + .path + "`"' <<<"$META"
)"

if [[ ! -f "$REVIEW_FILE" ]]; then
  cat > "$REVIEW_FILE" <<EOF
# PR #$PR — $TITLE

## Context

- **Repository:** $REPO
- **Author:** @$AUTHOR
- **Base:** \`$BASE\`
- **Head:** \`$HEAD\`
- **Changes:** $CHANGED_FILES files, +$ADDITIONS / -$DELETIONS
- **PR:** $URL
- **Reviewed commit:** _Not reviewed yet._

## Description

$BODY

## Changed files

$FILES

## Summary

_To be generated by Claude._

## Architecture / approach

_To be generated by Claude._

## Files worth reviewing

_To be generated by Claude._

## Things to verify

_To be generated by Claude._

## Findings

_To be generated by Claude._

## Tests

_To be generated by Claude._

## Suggested review order

_To be generated by Claude._

## My notes

EOF
fi

echo
echo "PR #$PR — $TITLE"
echo "$URL"
echo
echo "Worktree: $WORKTREE"
echo "Review:   $REVIEW_FILE"
echo
echo "When the review is finished: review-pr --done $REPO $PR"
echo

exec claude "/review-pr"
