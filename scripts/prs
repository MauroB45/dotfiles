#!/usr/bin/env bash

set -euo pipefail

command -v gh >/dev/null || {
  echo "gh is required"
  exit 1
}

command -v jq >/dev/null || {
  echo "jq is required"
  exit 1
}

command -v fzf >/dev/null || {
  echo "fzf is required"
  exit 1
}

HERE=false

case "${1:-}" in
  --here) HERE=true ;;
  "") ;;
  *)
    echo "Usage: prs [--here]"
    exit 1
    ;;
esac

# How many `gh pr view` lookups to run at once.
CONCURRENCY="${PRS_CONCURRENCY:-8}"

if [[ "$HERE" == true ]]; then
  CURRENT_REPO="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
  HEADER="$CURRENT_REPO PRs"
  EMPTY="No open PRs in $CURRENT_REPO"

  # gh pr list omits the repository, so add it to match the search results.
  SOURCES="$(
    gh pr list \
      --repo "$CURRENT_REPO" \
      --state=open \
      --limit=100 \
      --json number,title,author,updatedAt,isDraft,url,labels |
    jq --arg repo "$CURRENT_REPO" \
      'map(. + {repository: {nameWithOwner: $repo}, reason: "OPEN"})'
  )"
else
  HEADER="PR inbox"
  EMPTY="No PRs waiting for you 🎉"

  REVIEW_REQUESTED="$(
    gh search prs \
      --review-requested=@me \
      --state=open \
      --limit=50 \
      --json number,title,repository,author,updatedAt,isDraft,url,labels |
    jq 'map(. + {reason: "REVIEW"})'
  )"

  ASSIGNED="$(
    gh search prs \
      --assignee=@me \
      --state=open \
      --limit=50 \
      --json number,title,repository,author,updatedAt,isDraft,url,labels |
    jq 'map(. + {reason: "ASSIGNED"})'
  )"

  SOURCES="$REVIEW_REQUESTED"$'\n'"$ASSIGNED"
fi

# Dependabot and design PRs are noise in the review inbox.
PRS="$(
  jq -s '
    add
    | map(
        select(
          (.author.login | test("^dependabot") | not)
          and (any(.labels[]; .name | ascii_downcase == "design") | not)
        )
      )
    | group_by(.repository.nameWithOwner + "#" + (.number | tostring))
    | map(
        .[0] + {
          reason: (map(.reason) | unique | join("+"))
        }
      )
    | sort_by(.updatedAt)
    | reverse
  ' <<<"$SOURCES"
)"

COUNT="$(jq 'length' <<<"$PRS")"

if [[ "$COUNT" -eq 0 ]]; then
  echo "$EMPTY"
  exit 0
fi

# Check whether each PR has received any review. One API call per PR, so run
# them in parallel — serially this takes minutes once the inbox grows.
pr_reviewed() {
  local repo="$1" number="$2" reviewed

  reviewed="$(
    gh pr view "$number" \
      --repo "$repo" \
      --json latestReviews \
      --jq 'if (.latestReviews | length) > 0 then "REVIEWED" else "—" end'
  )" || reviewed="—"

  printf '%s\t%s\t%s\n' "$repo" "$number" "$reviewed"
}
export -f pr_reviewed

REVIEWS="$(
  jq -r '.[] | [.repository.nameWithOwner, .number] | @tsv' <<<"$PRS" |
  xargs -P "$CONCURRENCY" -n 2 bash -c 'pr_reviewed "$@"' _
)"

PRS="$(
  jq --arg reviews "$REVIEWS" '
    (
      $reviews
      | split("\n")
      | map(select(length > 0) | split("\t"))
      | map({key: (.[0] + "#" + .[1]), value: .[2]})
      | from_entries
    ) as $lookup
    | map(
        . + {
          reviewed: ($lookup[.repository.nameWithOwner + "#" + (.number | tostring)] // "—")
        }
      )
  ' <<<"$PRS"
)"

SELECTION="$(
  jq -r '
    .[] |
    [
      .repository.nameWithOwner,
      ("#" + (.number | tostring)),
      .reviewed,
      .reason,
      (if .isDraft then "DRAFT" else "READY" end),
      ("@" + .author.login),
      .title
    ] |
    @tsv
  ' <<<"$PRS" |
  column -t -s $'\t' |
  fzf \
    --header="$HEADER" \
    --prompt="Review > " \
    --height=80% \
    --reverse
)"

[[ -z "$SELECTION" ]] && exit 0

REPO="$(awk '{print $1}' <<<"$SELECTION")"
PR="$(awk '{print $2}' <<<"$SELECTION" | tr -d '#')"

exec review-pr "$REPO" "$PR"
