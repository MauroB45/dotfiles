#!/usr/bin/env -S python3 -I

# gh runs outside the sandbox and `gh api` turns into a write as soon as it is
# given -f, -F, -X or --input, so an allow rule on the command prefix also
# approves posting comments or deleting branches. Approve a Bash call only when
# it is a single `gh api` GET built from an allow-list of flags.
#
# In auto mode, a call this hook does not approve goes to the classifier rather
# than to a prompt, so a write would still run. Deny any `gh api` call that
# shows a write signal; GitHub writes are for the user to run. Leave everything
# else to the normal permission flow.

import json
import re
import shlex
import sys

FLAGS_WITH_VALUE = {"--jq", "-q", "--template", "-t", "--cache", "-H", "--header"}
FLAGS_WITHOUT_VALUE = {"--paginate", "--slurp", "-i", "--include", "--silent"}
ENDPOINT = re.compile(r"^/?[A-Za-z0-9._~/{}:@%+,=-]+(\?[A-Za-z0-9._~/{}:@%+,=&-]*)?$")


def is_read_only(command):
    # Shell expansion still runs inside double quotes, which shlex can't tell
    # apart from single quotes.
    if "\n" in command or "$" in command or "`" in command:
        return False

    lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    try:
        tokens = list(lexer)
    except ValueError:
        return False

    if tokens[:2] != ["gh", "api"]:
        return False
    if any(token and set(token) <= set(lexer.punctuation_chars) for token in tokens):
        return False

    endpoints = []
    args = iter(tokens[2:])
    for arg in args:
        if not arg.startswith("-"):
            endpoints.append(arg)
            continue
        flag, has_inline_value, value = arg.partition("=")
        if flag in FLAGS_WITHOUT_VALUE and not has_inline_value:
            continue
        if flag not in FLAGS_WITH_VALUE:
            return False
        if not has_inline_value:
            value = next(args, None)
            if value is None:
                return False
        if flag in {"-H", "--header"} and not value.lower().startswith("accept:"):
            return False

    if len(endpoints) != 1:
        return False
    endpoint = endpoints[0]
    if "//" in endpoint or not ENDPOINT.match(endpoint):
        return False
    return endpoint.lstrip("/").split("/")[0] != "graphql"


FIELD_FLAGS = {"-f", "-F", "--field", "--raw-field"}


def is_write(command):
    # Looser than is_read_only on purpose: it must catch writes inside compound
    # commands, and a read that matches by mistake is only refused, not run.
    lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    try:
        tokens = list(lexer)
    except ValueError:
        tokens = command.split()

    segment = []
    for token in tokens + [";"]:
        if token and set(token) <= set(lexer.punctuation_chars):
            if segment_writes(segment):
                return True
            segment = []
        else:
            segment.append(token)
    return False


def segment_writes(tokens):
    for i in range(len(tokens) - 1):
        if tokens[i].endswith("gh") and tokens[i + 1] == "api":
            return args_write(tokens[i + 2 :])
    return False


def args_write(args):
    args = iter(args)
    for arg in args:
        flag, has_inline_value, value = arg.partition("=")
        if flag in {"-X", "--method"}:
            method = value if has_inline_value else next(args, "")
        elif arg.startswith("-X"):
            method = arg[2:]
        else:
            method = "GET"
        if method.upper() != "GET":
            return True
        if flag in FIELD_FLAGS or arg[:2] in {"-f", "-F"} and not arg.startswith("--"):
            return True
        if flag == "--input":
            return True
        if arg.lstrip("/").split("/")[0] == "graphql":
            return True
    return False


def deny(reason):
    json.dump(
        {
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": reason,
            }
        },
        sys.stdout,
    )


def main():
    try:
        event = json.load(sys.stdin)
    except ValueError:
        return
    if event.get("tool_name") != "Bash":
        return
    command = str(event.get("tool_input", {}).get("command", "")).strip()
    if is_write(command):
        deny("gh api writes are for the user to run, with `! gh api ...`")
        return
    if not is_read_only(command):
        return

    json.dump(
        {
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "allow",
                "permissionDecisionReason": "read-only gh api GET",
            }
        },
        sys.stdout,
    )


main()
