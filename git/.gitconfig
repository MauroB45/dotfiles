[include]
    # Machine-specific default identity
    path = ~/.gitconfig-local

[includeIf "gitdir:~/Code/work/"]
    # Overrides identity for work repositories
    path = ~/.gitconfig-work

[includeIf "gitdir:~/Code/personal/"]
    # Overrides identity for personal repositories
    path = ~/.gitconfig-personal

[init]
    defaultBranch = main

[core]
    excludesfile = ~/.gitignore_global
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false

[merge]
    conflictstyle = zdiff3

[push]
    autoSetupRemote = true

[fetch]
    prune = true
